CC = gcc
CFLAGS = -Wall -Wextra -Wpedantic -std=c11
THREAD_FLAGS = -pthread

AGENT = agent
CONTROLLER = controller

AGENT_SRC = agent_823.c
CONTROLLER_SRC = controller_823.c

all: $(AGENT) $(CONTROLLER)

$(AGENT): $(AGENT_SRC)
	$(CC) $(CFLAGS) $(THREAD_FLAGS) $(AGENT_SRC) -o $(AGENT)

$(CONTROLLER): $(CONTROLLER_SRC)
	$(CC) $(CFLAGS) $(THREAD_FLAGS) $(CONTROLLER_SRC) -o $(CONTROLLER)

clean:
	rm -f $(AGENT) $(CONTROLLER) *.o

.PHONY: all clean
